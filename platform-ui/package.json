{
  "name": "@bhairab-patra/platform-ui",
  "version": "1.1.0",
  "description": "Shared Angular UI component library — ButtonComponent & CardComponent",
  "keywords": [
    "angular",
    "library",
    "ui",
    "components"
  ],
  "license": "MIT",
  "scripts": {
    "lint": "ng lint platform-ui",
    "lint:docs": "ng lint docs",
    "lint:all": "ng lint platform-ui && ng lint docs",

    "build:local": "ng build platform-ui --configuration development",
    "build:publish": "ng build platform-ui --configuration production",
    "build": "npm run build:local",
    "build:watch": "ng build platform-ui --configuration development --watch",
    "pack:local": "npm run build:local && cd dist/platform-ui && npm pack",

    "publish:lib": "npm run build:publish && npm publish ./dist/platform-ui --access public --registry https://registry.npmjs.org",

    "build:elements": "ng build elements --configuration production && node scripts/concat-elements.js",
    "build:elements:dev": "ng build elements --configuration development && node scripts/concat-elements.js",
    "build:full": "npm run build:publish && npm run build:elements && node scripts/copy-elements-to-dist.js",

    "test": "ng test platform-ui",
    "docs": "ng serve docs --port 4210 --open",
    "docs:build": "ng build docs",
    "serve:demo": "npx http-server . -p 4300 --cors -o demo/index.html"
  },
  "peerDependencies": {
    "@angular/common": "^19.0.0",
    "@angular/core": "^19.0.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular/animations": "^19.2.25",
    "@angular/cli": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/elements": "^19.2.25",
    "@angular/forms": "^19.2.25",
    "@angular/platform-browser": "^19.0.0",
    "@angular/router": "^19.2.25",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "21.0.1",
    "eslint": "^9.39.1",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^19.0.0",
    "tslib": "^2.3.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "8.46.4",
    "zone.js": "~0.15.0"
  },
  "dependencies": {
    "@bhairab-patra/platform-ui": "file:dist/platform-ui"
  }
}